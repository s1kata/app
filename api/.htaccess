RewriteEngine On

# Проброс Authorization в PHP
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Tourvisor proxy
RewriteRule ^tourvisor-mobile(.*)$ /backend/api/tourvisor-mobile.php$1 [L,QSA]

# Payment API
RewriteRule ^create-payment$ create-payment.php [L,QSA]
RewriteRule ^payment-webhook$ payment-webhook.php [L,QSA]
RewriteRule ^payment-status/([^/]+)$ payment-status.php?transactionId=$1 [L,QSA]

# Next-patch cache / cron / hotels / tours (pretty URLs)
RewriteRule ^cache/hotel-images$ cache/hotel-images.php [L,QSA]
RewriteRule ^cron/price-watch$ cron/price-watch.php [L,QSA]
RewriteRule ^cron/daily-hots$ cron/daily-hots.php [L,QSA]
RewriteRule ^hotels/search$ hotels/search.php [L,QSA]
RewriteRule ^hotels/details$ hotels/details.php [L,QSA]
RewriteRule ^tours/hots$ tours/hots.php [L,QSA]
RewriteRule ^tours/search$ tours/search.php [L,QSA]
RewriteRule ^tours/search-status$ tours/search-status.php [L,QSA]
RewriteRule ^tours/search-results$ tours/search-results.php [L,QSA]
RewriteRule ^tours/search-continue$ tours/search-continue.php [L,QSA]
RewriteRule ^tours/details$ tours/details.php [L,QSA]
RewriteRule ^tours/flights$ tours/flights.php [L,QSA]
RewriteRule ^tours/dates$ tours/dates.php [L,QSA]
